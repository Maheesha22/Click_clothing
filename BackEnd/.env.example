# Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
# Option 1: Individual parameters (recommended for most deployments)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=click_clothing
DB_USER=root
DB_PASS=

# Option 2: Database URL (alternative to individual parameters)
# Format: mysql://user:password@host:port/database
# DATABASE_URL=mysql://root:password@localhost:3306/click_clothing

# Database Settings
DB_LOGGING=false
DB_SYNC=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
# For production: Set to your frontend domain (e.g., https://yourdomain.com)
# For development: Set to http://localhost:5173 or http://localhost:3000
# Multiple origins can be comma-separated: http://localhost:5173,https://yourdomain.com
CORS_ORIGIN=https://click-clothing-kie4.vercel.app
FRONTEND_URL=https://click-clothing-kie4.vercel.app

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com 
EMAIL_PASS=your-app-password
STORE_EMAIL=store@example.com
