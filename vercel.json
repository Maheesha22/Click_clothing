{
  "buildCommand": "cd FrontEnd && npm install && npm run build",
  "outputDirectory": "FrontEnd/dist",
  "installCommand": "echo 'skip root install'",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/BackEnd/api/index.js" },
    { "source": "/(.*)", "destination": "/FrontEnd/index.html" }
  ]
}
